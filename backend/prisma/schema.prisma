datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
}

enum CustomerStatus {
  active
  inactive
  lead
  churned
}

enum ProductStatus {
  active
  archived
  draft
}

enum BillingInterval {
  day
  week
  month
  quarter
  year
}

enum PricingModel {
  flat_fee
  per_seat
  tiered
  usage_based
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  active
  paused
  canceled
  cancelled
  trialing
  past_due
  incomplete
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  draft
  open
  unpaid
  paid
  overdue
  partially_paid
  void
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Customer {
  id                      String         @id @default(uuid())
  name                    String
  email                   String         @unique
  companyName             String?
  status                  CustomerStatus @default(active)
  mrr                     Float          @default(0.0)
  currency                String         @default("USD")
  billingAddress          Json?
  taxId                   String?
  stripeCustomerId        String?
  subscriptions           Subscription[]
  invoices                Invoice[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@map("customers")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  description String?
  status      ProductStatus @default(active)
  features    String[]      @default([])
  plans       Plan[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("products")
}

model Plan {
  id              String          @id @default(uuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  name            String
  code            String          @unique
  description     String?
  amount          Float
  currency        String          @default("USD")
  interval        BillingInterval @default(month)
  intervalCount   Int             @default(1)
  pricingModel    PricingModel    @default(flat_fee)
  trialPeriodDays Int             @default(0)
  isActive        Boolean         @default(true)
  subscriptions   Subscription[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(ACTIVE)
  quantity           Int                @default(1)
  unitAmount         Float              @default(0.0)
  totalAmount        Float              @default(0.0)
  mrr                Float              @default(0.0)
  currency           String             @default("USD")
  billingInterval    BillingInterval    @default(month)
  startDate          DateTime           @default(now())
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime           @default(now())
  billingCycleAnchor DateTime           @default(now())
  billingSequence    Int                @default(1)
  lastBillingKey     String?
  lastBilledAt       DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  pausedAt           DateTime?
  trialStart         DateTime?
  trialEnd           DateTime?
  metadata           Json?
  invoices           Invoice[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, nextBillingDate])
  @@index([customerId])
  @@index([planId])
  @@map("subscriptions")
}

model Invoice {
  id                 String            @id @default(uuid())
  invoiceNumber      String            @unique
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscriptionId     String?
  subscription       Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status             InvoiceStatus     @default(UNPAID)
  currency           String            @default("USD")
  subtotal           Decimal           @default(0.00) @db.Decimal(12, 2)
  taxRate            Decimal           @default(0.00) @db.Decimal(5, 2)
  taxAmount          Decimal           @default(0.00) @db.Decimal(12, 2)
  total              Decimal           @default(0.00) @db.Decimal(12, 2)
  amountPaid         Decimal           @default(0.00) @db.Decimal(12, 2)
  amountDue          Decimal           @default(0.00) @db.Decimal(12, 2)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  billingCycleKey    String?           @unique
  invoiceDate        DateTime          @default(now())
  dueDate            DateTime
  paidAt             DateTime?
  notes              String?
  lineItems          InvoiceLineItem[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String    @id @default(uuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitAmount  Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2)
  planId      String?
  planName    String?
  planCode    String?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
  @@map("invoice_line_items")
}
