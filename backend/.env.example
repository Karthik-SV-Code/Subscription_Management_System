# ==============================================================================
# SubscriptIQ Backend Environment Variables
# ==============================================================================
# Copy this file to .env and customize values for your local development environment.

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscriptiq?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="subscriptiq_super_secret_jwt_key_brightloop_2026"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=10

# CORS Configuration (Frontend URL)
CORS_ORIGIN="http://localhost:3000"
