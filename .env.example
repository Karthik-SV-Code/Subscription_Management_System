# ==============================================================================
# SubscriptIQ Environment Configuration
# ==============================================================================
# Note: For production and local development, copy this file to .env.local
# The app includes fallback defaults so it will build and run without crashing
# even when these variables are not yet configured.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend REST API Endpoint (for future REST microservices integration)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase Authentication & Database Integration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

